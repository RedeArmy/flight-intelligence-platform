#!/bin/sh
# Blocks pushing to main from any local branch. Enable with: make hooks
zero=0000000000000000000000000000000000000000
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: pushing to '$remote_ref' is blocked. Push a branch and open a pull request." >&2
      exit 1
      ;;
  esac
done
exit 0
