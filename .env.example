# Copy to .env for local development (git-ignored). Real environment variables override this file.
# The file is read only when APP_ENV is unset or local/test, and it cannot select staging/production.
# Never put secrets or provider credentials here (ADR-018): run `make local-secrets` and the API reads ./secrets.
# See docs/operations/configuration.md.
APP_ENV=local
APP_VERSION=dev
LOG_LEVEL=debug
LOG_FORMAT=text
HTTP_ADDR=:8080
HTTP_OPERATOR_ADDR=127.0.0.1:8081
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fip
POSTGRES_USER=fip_app
POSTGRES_SSLMODE=disable
SECRETS_DIR=./secrets

# Redis is optional: empty means per-instance rate limits. A local Redis has no TLS.
REDIS_ADDR=
REDIS_TLS=false
